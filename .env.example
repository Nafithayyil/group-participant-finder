# Used by docker-compose.yml for a single-container deployment.
# Get these from your Supabase project: Project Settings -> API
# Server-side only: the browser never receives the Supabase URL or any key.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origin the frontend is served from (used for Socket.IO/CORS)
FRONTEND_ORIGIN=http://localhost:4000
